+"""Tests for Stage 2 shared session seed resolution."""
+from alpasim_runtime.stage2.seeds import shared_session_seed
+
+
+def test_no_flag_returns_none_for_zero(monkeypatch):
+    monkeypatch.delenv("STAGE2_RENDER_SEED", raising=False)
+    assert shared_session_seed(0) is None
+
+
+def test_no_flag_preserves_spec_seed(monkeypatch):
+    monkeypatch.delenv("STAGE2_RENDER_SEED", raising=False)
+    assert shared_session_seed(777) == 777
+
+
+def test_flag_pins_all_services(monkeypatch):
+    monkeypatch.setenv("STAGE2_RENDER_SEED", "20261002")
+    assert shared_session_seed(0) == 20261002
+    # pinned seed wins over the spec seed
+    assert shared_session_seed(777) == 20261002
+
+
+def test_empty_flag_ignored(monkeypatch):
+    monkeypatch.setenv("STAGE2_RENDER_SEED", "")
+    assert shared_session_seed(0) is None
