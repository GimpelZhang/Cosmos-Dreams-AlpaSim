@@ -0,0 +1,123 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+"""Stage 2 tests: variant-driven initial-frame appearance editing."""
+
+from __future__ import annotations
+
+import base64
+import io
+import json
+from contextlib import contextmanager
+
+import pytest
+import yaml
+from PIL import Image
+
+from alpasim_grpc.v0.video_model_pb2 import ImageFormat
+
+from alpasim_runtime.stage2 import frame_edit
+
+SCENE_ID = "clipgt-testscene-0000"
+
+
+def _jpeg(size_wh, color=(100, 150, 200)):
+    img = Image.new("RGB", size_wh, color)
+    buf = io.BytesIO()
+    img.save(buf, format="JPEG")
+    return buf.getvalue()
+
+
+def _write_spec(tmp_path, frame_edit_prompt=None):
+    variant = {"id": "v99_test"}
+    if frame_edit_prompt is not None:
+        variant["frame_edit_prompt"] = frame_edit_prompt
+    spec = tmp_path / "variants.yaml"
+    spec.write_text(yaml.safe_dump({
+        "base_scene": SCENE_ID,
+        "variants": [variant],
+    }))
+    return spec
+
+
+def _write_credentials(tmp_path):
+    cred = tmp_path / "image_editor_model.txt"
+    cred.write_text(
+        "模型：test-editor-model\n"
+        "ARK_API_KEY: ark-test-key-1234567890\n"
+    )
+    return cred
+
+
+def _fake_urlopen(monkeypatch, returned_size_wh):
+    edited_b64 = base64.b64encode(_jpeg(returned_size_wh, (240, 240, 240))).decode()
+    captured = {}
+
+    @contextmanager
+    def fake_urlopen(req, timeout=None):
+        captured["request"] = req
+        captured["timeout"] = timeout
+
+        class FakeResponse:
+            def read(self):
+                return json.dumps(
+                    {"data": [{"b64_json": edited_b64}]}
+                ).encode()
+
+            def __enter__(self):
+                return self
+
+            def __exit__(self, *args):
+                return False
+
+        yield FakeResponse()
+
+    monkeypatch.setattr(frame_edit.urllib.request, "urlopen", fake_urlopen)
+    return captured
+
+
+def test_no_flag_returns_frames_unchanged(monkeypatch):
+    monkeypatch.delenv("STAGE2_VARIANT_SPEC", raising=False)
+    frames = [(_jpeg((64, 40)), ImageFormat.JPEG)]
+    assert frame_edit.edit_initial_frames(frames, SCENE_ID) is frames
+
+
+def test_variant_without_edit_prompt_unchanged(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path)
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    frames = [(_jpeg((64, 40)), ImageFormat.JPEG)]
+    assert frame_edit.edit_initial_frames(frames, SCENE_ID) is frames
+
+
+def test_edit_resizes_to_session_resolution(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path, frame_edit_prompt="edit it to snow")
+    cred = _write_credentials(tmp_path)
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    monkeypatch.setenv("STAGE2_EDITOR_CREDENTIALS_FILE", str(cred))
+    captured = _fake_urlopen(monkeypatch, (288, 158))
+
+    frames = [(_jpeg((128, 70)), ImageFormat.JPEG)]
+    out = frame_edit.edit_initial_frames(frames, SCENE_ID)
+
+    data, fmt = out[0]
+    assert fmt == ImageFormat.JPEG
+    assert Image.open(io.BytesIO(data)).size == (128, 70)
+    body = json.loads(captured["request"].data)
+    assert body["model"] == "test-editor-model"
+    assert body["prompt"] == "edit it to snow"
+    assert body["response_format"] == "b64_json"
+    assert body["image"][0].startswith("data:image/jpeg;base64,")
+    assert captured["request"].headers["Authorization"] == "Bearer ark-test-key-1234567890"
+
+
+def test_missing_credentials_raises(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path, frame_edit_prompt="edit it to snow")
+    missing = tmp_path / "no-such-file.txt"
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    monkeypatch.setenv("STAGE2_EDITOR_CREDENTIALS_FILE", str(missing))
+    with pytest.raises(FileNotFoundError):
+        frame_edit.edit_initial_frames(
+            [(_jpeg((64, 40)), ImageFormat.JPEG)], SCENE_ID)
