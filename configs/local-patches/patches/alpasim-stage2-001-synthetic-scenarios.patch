@@ -0,0 +1,18 @@
+"""Resolve the shared Stage 2 session seed.
+
+The renderer, driver and traffic services each have their own seed inputs;
+when STAGE2_RENDER_SEED is set all three sessions are pinned to the same
+value so the whole closed loop is reproducible (plan §7.3). Without it, the
+Stage 1 behavior is preserved: session_seed 0 reaches the services as None,
+and driver/traffic each draw a random seed for the run.
+"""
+from __future__ import annotations
+
+import os
+
+
+def shared_session_seed(session_seed: int) -> int | None:
+    pinned = os.environ.get("STAGE2_RENDER_SEED")
+    if pinned:
+        return int(pinned)
+    return session_seed or None
diff --git a/src/runtime/alpasim_runtime/stage2/variant_actors.py b/src/runtime/alpasim_runtime/stage2/variant_actors.py
new file mode 100644
index 0000000..63f92e2
--- /dev/null
+++ b/src/runtime/alpasim_runtime/stage2/variant_actors.py
@@ -0,0 +1,128 @@
+"""Merge synthetic actor TrafficObjects described by a Stage 2 variants spec.
+
+Selection is per process via environment (one variant per wizard, see
+rollout_index_verdict.txt):
+- STAGE2_VARIANT_SPEC: path to variants.yaml
+- STAGE2_VARIANT_ID: variant id inside that file
+
+Actors are authored in the ego start rig frame (x forward, y left). The rig ->
+clip-global transform is taken from the recorded GT rig trajectory at the
+render start timestamp; actor trajectory timestamps reuse the rig trajectory's
+video frame timestamps so renderer membership tests always match.
+"""
+from __future__ import annotations
+
+import math
+import os
+from pathlib import Path
+
+import numpy as np
+import yaml
+
+from alpasim_utils.geometry import Pose, Trajectory
+from alpasim_utils.scenario import AABB, TrafficObject, TrafficObjects
+
+TRACK_PREFIX = "s2_"
+
+
+def _load_variant(spec_path: str, variant_id: str, scene_id: str) -> dict | None:
+    doc = yaml.safe_load(Path(spec_path).read_text())
+    if doc.get("base_scene") != scene_id:
+        return None
+    return next((v for v in doc["variants"] if v["id"] == variant_id), None)
+
+
+def _yaw_quat(yaw: float) -> np.ndarray:
+    # Pose stores quaternions in scipy order [x, y, z, w]
+    half = 0.5 * yaw
+    return np.array([0.0, 0.0, math.sin(half), math.cos(half)], dtype=np.float32)
+
+
+def build_synthetic_objects(
+    variant: dict,
+    rig_trajectory,
+    render_start_us: int,
+    end_us: int,
+) -> dict[str, TrafficObject]:
+    rig_start_pose = rig_trajectory.interpolate_pose(render_start_us)
+    rig_yaw = rig_start_pose.yaw()
+    cos_y, sin_y = math.cos(rig_yaw), math.sin(rig_yaw)
+
+    objects: dict[str, TrafficObject] = {}
+    for actor in variant["actors"]:
+        act_abs_us = int(render_start_us + actor["activate_s"] * 1e6)
+        end_rel_s = actor.get(
+            "traj_end_s", (end_us - render_start_us) / 1e6)
+        end_abs_us = min(int(render_start_us + end_rel_s * 1e6), end_us)
+        if end_abs_us < act_abs_us:
+            continue
+
+        ts = rig_trajectory.timestamps_us
+        window = ts[(ts >= act_abs_us) & (ts <= end_abs_us)]
+        if len(window) == 0:
+            continue
+
+        local_pose = Pose(
+            np.array(actor["start_xy_rig"] + [0.0], dtype=np.float32),
+            _yaw_quat(actor.get("yaw_deg", 0.0) * math.pi / 180.0),
+        )
+        world_pose = rig_start_pose @ local_pose
+        p0 = world_pose.vec3
+        q0 = world_pose.quat
+
+        vx_rig, vy_rig = actor["velocity_xy"]
+        vx_world = cos_y * vx_rig - sin_y * vy_rig
+        vy_world = sin_y * vx_rig + cos_y * vy_rig
+
+        t_rel_s = (window.astype(np.int64) - act_abs_us) / 1e6
+        positions = np.empty((len(window), 3), dtype=np.float32)
+        positions[:, 0] = p0[0] + vx_world * t_rel_s
+        positions[:, 1] = p0[1] + vy_world * t_rel_s
+        positions[:, 2] = p0[2]
+        quaternions = np.tile(q0, (len(window), 1)).astype(np.float32)
+
+        box = actor["box_size_xyz"]
+        track_id = TRACK_PREFIX + actor["id"]
+        objects[track_id] = TrafficObject(
+            track_id=track_id,
+            aabb=AABB(float(box[0]), float(box[1]), float(box[2])),
+            trajectory=Trajectory(window, positions, quaternions),
+            is_static=False,
+            label_class=actor["label_class"],
+        )
+    return objects
+
+
+def resolve_variant_prompt(scene_id: str) -> tuple[str, str] | None:
+    """Return (positive, negative) text prompts for the selected variant."""
+    spec_path = os.environ.get("STAGE2_VARIANT_SPEC")
+    variant_id = os.environ.get("STAGE2_VARIANT_ID")
+    if not spec_path or not variant_id or not Path(spec_path).exists():
+        return None
+    variant = _load_variant(spec_path, variant_id, scene_id)
+    if variant is None:
+        return None
+    return variant["prompt_positive"], variant["prompt_negative"]
+
+
+def merge_synthetic_actors(
+    traffic_objects: TrafficObjects,
+    scene_id: str,
+    rig_gt_trajectory,
+    render_start_us: int,
+    end_us: int,
+) -> TrafficObjects:
+    spec_path = os.environ.get("STAGE2_VARIANT_SPEC")
+    variant_id = os.environ.get("STAGE2_VARIANT_ID")
+    if not spec_path or not variant_id or not Path(spec_path).exists():
+        return traffic_objects
+
+    variant = _load_variant(spec_path, variant_id, scene_id)
+    if variant is None:
+        return traffic_objects
+
+    synthetic = build_synthetic_objects(
+        variant, rig_gt_trajectory, render_start_us, end_us)
+    if not synthetic:
+        return traffic_objects
+    return TrafficObjects({**traffic_objects, **synthetic})
