diff --git a/src/runtime/alpasim_runtime/stage2/frame_edit.py b/src/runtime/alpasim_runtime/stage2/frame_edit.py
new file mode 100644
index 0000000..f24a516
--- /dev/null
+++ b/src/runtime/alpasim_runtime/stage2/frame_edit.py
@@ -0,0 +1,132 @@
+"""Edit the session initial frame for a Stage 2 weather/lighting variant.
+
+The deployed OmniDreams checkpoint does not respond to prompt-only
+appearance edits; per paper Sec. 9.3.1 weather/lighting variants edit the
+first-frame RGB together with the text prompt, and the world model then
+propagates the edited appearance through the generated rollout.
+
+When the selected variant declares ``frame_edit_prompt``, each initial frame
+is sent to a remote image-editing model (model id + API key read from a
+credentials file mounted read-only; path overridden by
+STAGE2_EDITOR_CREDENTIALS_FILE) and the returned image replaces it as the
+renderer session seed. Frames are uploaded/returned as base64 over HTTPS
+using the standard library, so no extra runtime dependency is needed.
+"""
+from __future__ import annotations
+
+import base64
+import io
+import json
+import logging
+import os
+import re
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+from PIL import Image
+
+from alpasim_grpc.v0.video_model_pb2 import ImageFormat
+
+from alpasim_runtime.stage2 import variant_actors
+
+_EDIT_URL = "https://ark.cn-beijing.volces.com/api/v3/images/generations"
+_DEFAULT_CREDENTIALS = "/mnt/stage2/image_editor_model.txt"
+_TIMEOUT_S = 180
+_ATTEMPTS = 2
+
+log = logging.getLogger(__name__)
+
+
+def _read_credentials(path: str) -> tuple[str, str]:
+    text = Path(path).read_text()
+    key = re.search(r"ARK_API_KEY:\s*(\S+)", text).group(1)
+    model = re.search(r"模型：(\S+)", text).group(1)
+    return model, key
+
+
+def _reencode(data: bytes, size_wh: tuple[int, int], fmt: ImageFormat) -> bytes:
+    # The editing model returns a 2K image; restore the session resolution and
+    # encoding expected by the renderer camera spec.
+    img = Image.open(io.BytesIO(data)).convert("RGB")
+    if img.size != size_wh:
+        img = img.resize(size_wh, Image.LANCZOS)
+    if fmt == ImageFormat.JPEG:
+        buf = io.BytesIO()
+        img.save(buf, format="JPEG", quality=92)
+        return buf.getvalue()
+    buf = io.BytesIO()
+    img.save(buf, format="PNG")
+    return buf.getvalue()
+
+
+def _edit_image(
+    data: bytes,
+    size_wh: tuple[int, int],
+    fmt: ImageFormat,
+    edit_prompt: str,
+    model: str,
+    key: str,
+) -> bytes:
+    mime = "image/png" if fmt == ImageFormat.PNG else "image/jpeg"
+    body = {
+        "model": model,
+        "prompt": edit_prompt,
+        "size": "2K",
+        "response_format": "b64_json",
+        "image": [f"data:{mime};base64,{base64.b64encode(data).decode()}"],
+        "watermark": False,
+    }
+    req = urllib.request.Request(
+        _EDIT_URL,
+        data=json.dumps(body).encode(),
+        headers={
+            "Authorization": f"Bearer {key}",
+            "Content-Type": "application/json",
+        },
+    )
+    last_error: Exception | None = None
+    for attempt in range(1, _ATTEMPTS + 1):
+        try:
+            with urllib.request.urlopen(req, timeout=_TIMEOUT_S) as response:
+                payload = json.loads(response.read())
+            edited = base64.b64decode(payload["data"][0]["b64_json"])
+            return _reencode(edited, size_wh, fmt)
+        except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, KeyError) as exc:
+            last_error = exc
+            log.warning("frame edit attempt %d/%d failed: %s", attempt, _ATTEMPTS, exc)
+    raise RuntimeError(f"image edit request failed after {_ATTEMPTS} attempts: {last_error}")
+
+
+def edit_initial_frames(
+    initial_frames: list[tuple[bytes, ImageFormat]], scene_id: str
+) -> list[tuple[bytes, ImageFormat]]:
+    """Return initial frames with the selected variant's appearance edit.
+
+    No-op unless STAGE2_VARIANT_SPEC/STAGE2_VARIANT_ID select a variant that
+    declares ``frame_edit_prompt``; Stage 1 behavior is preserved otherwise.
+    """
+    spec_path = os.environ.get("STAGE2_VARIANT_SPEC")
+    variant_id = os.environ.get("STAGE2_VARIANT_ID")
+    if not spec_path or not variant_id or not Path(spec_path).exists():
+        return initial_frames
+    variant = variant_actors._load_variant(spec_path, variant_id, scene_id)
+    edit_prompt = variant.get("frame_edit_prompt") if variant is not None else None
+    if not edit_prompt:
+        return initial_frames
+
+    cred_path = os.environ.get(
+        "STAGE2_EDITOR_CREDENTIALS_FILE", _DEFAULT_CREDENTIALS)
+    if not Path(cred_path).exists():
+        raise FileNotFoundError(
+            f"Stage 2 frame edit enabled but credentials file missing: {cred_path}")
+    model, key = _read_credentials(cred_path)
+
+    edited: list[tuple[bytes, ImageFormat]] = []
+    for data, fmt in initial_frames:
+        with Image.open(io.BytesIO(data)) as src:
+            size_wh = src.size
+        log.info("editing initial frame with variant prompt (model=%s)", model)
+        edited.append(
+            (_edit_image(data, size_wh, fmt, edit_prompt, model, key), fmt))
+    return edited
