+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+"""Stage 2 Task 2.2 tests: per-variant prompt + random_seed propagation."""
+
+from __future__ import annotations
+
+from types import SimpleNamespace
+
+import yaml
+
+from alpasim_grpc.v0.video_model_pb2 import SessionId as RemoteSessionId
+from alpasim_runtime.config import VideoModelConfig
+from alpasim_runtime.services import video_model_service as vms_module
+from alpasim_runtime.services.service_base import SessionInfo
+from alpasim_runtime.services.session_configs import RendererSessionConfig
+from alpasim_runtime.services.video_model_service import VideoModelService
+
+SCENE_ID = "clipgt-testscene-0000"
+
+
+def _write_spec(tmp_path):
+    spec = tmp_path / "variants.yaml"
+    spec.write_text(yaml.safe_dump({
+        "base_scene": SCENE_ID,
+        "variants": [{
+            "id": "v99_test",
+            "prompt_positive": "POSITIVE PROMPT",
+            "prompt_negative": "NEGATIVE PROMPT",
+        }],
+    }))
+    return spec
+
+
+def _service(monkeypatch):
+    service = VideoModelService("localhost:50051", VideoModelConfig())
+    service._camera_catalog = object()
+    monkeypatch.setattr(service, "_register_scene_cameras", lambda *a: None)
+    monkeypatch.setattr(
+        vms_module, "build_camera_specs_and_initial_frames",
+        lambda **kw: ([], [], []))
+    monkeypatch.setattr(vms_module, "extract_hdmap_for_video_model", lambda p: b"")
+    return service
+
+
+async def _initialize(service, seed=None):
+    captured = {}
+
+    async def fake_start_session(**kwargs):
+        captured.update(kwargs)
+        return "started"
+
+    service.start_session = fake_start_session
+    cfg = RendererSessionConfig(
+        data_source=SimpleNamespace(scene_id=SCENE_ID, source="/tmp/fake.usdz"),
+        runtime_cameras=[],
+        gt_ego_trajectory=None,
+        image_format="png",
+        ego_mask_rig_config_id=None,
+        random_seed=seed,
+    )
+    await service._initialize_session(
+        SessionInfo(uuid="u", broadcaster=None, session_config=cfg))
+    return captured
+
+
+async def test_no_flag_keeps_stage1_defaults(tmp_path, monkeypatch):
+    captured = await _initialize(_service(monkeypatch))
+    assert captured["text_prompt_positive"] is None
+    assert captured["text_prompt_negative"] is None
+    assert captured["random_seed"] == 0
+
+
+async def test_variant_prompt_and_seed_forwarded(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path)
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    monkeypatch.setenv("STAGE2_RENDER_SEED", "20261002")
+    captured = await _initialize(_service(monkeypatch))
+    assert captured["text_prompt_positive"] == "POSITIVE PROMPT"
+    assert captured["text_prompt_negative"] == "NEGATIVE PROMPT"
+    assert captured["random_seed"] == 20261002
+
+
+async def test_seed_falls_back_to_session_seed(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path)
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    captured = await _initialize(_service(monkeypatch), seed=77)
+    assert captured["random_seed"] == 77
+
+
+async def test_scene_mismatch_no_prompt(tmp_path, monkeypatch):
+    spec = tmp_path / "variants.yaml"
+    spec.write_text(yaml.safe_dump({
+        "base_scene": "clipgt-other-scene",
+        "variants": [{
+            "id": "v99_test",
+            "prompt_positive": "POSITIVE PROMPT",
+            "prompt_negative": "NEGATIVE PROMPT",
+        }],
+    }))
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    monkeypatch.setenv("STAGE2_RENDER_SEED", "5")
+    captured = await _initialize(_service(monkeypatch))
+    assert captured["text_prompt_positive"] is None
+    assert captured["random_seed"] == 5
+
+
+async def test_start_session_builds_request(tmp_path, monkeypatch):
+    entries = []
+
+    async def fake_broadcast(entry):
+        entries.append(entry)
+
+    async def fake_rpc(name, group, call, request):
+        return RemoteSessionId(session_id="remote-sid")
+
+    service = VideoModelService("localhost:50051", VideoModelConfig())
+    service.stub = SimpleNamespace(start_session=lambda request: None)
+    monkeypatch.setattr(service, "_broadcast", fake_broadcast)
+    monkeypatch.setattr(vms_module, "profiled_rpc_call", fake_rpc)
+
+    result = await service.start_session(
+        hdmap_bytes=b"",
+        camera_specs=[],
+        rig_to_camera=[],
+        initial_frames=[],
+        text_prompt_positive="POSITIVE PROMPT",
+        text_prompt_negative="NEGATIVE PROMPT",
+        random_seed=42,
+    )
+    request = entries[0].video_model_session_request
+    assert result.session_id == "remote-sid"
+    assert request.text_prompt.positive == "POSITIVE PROMPT"
+    assert request.text_prompt.negative == "NEGATIVE PROMPT"
+    assert request.random_seed == 42
diff --git a/src/wizard/configs/extras/stage2_env.yaml b/src/wizard/configs/extras/stage2_env.yaml
new file mode 100644
index 0000000..bf42224
--- /dev/null
+++ b/src/wizard/configs/extras/stage2_env.yaml
@@ -0,0 +1,44 @@
+# @package _global_
+# Stage 2: inject STAGE2_* feature-flag env into the runtime container and
+# bind-mount the variants spec and image-editor credentials read-only under
+# /mnt/stage2. Values come from the wizard shell environment; volumes list
+# repeats all runtime defaults (Hydra list composition replaces, not merges).
+services:
+  runtime:
+    environments:
+      - UV_LINK_MODE=copy
+      - STAGE2_VARIANT_SPEC=/mnt/stage2/variants.yaml
+      - STAGE2_VARIANT_ID=${oc.env:STAGE2_VARIANT_ID,}
+      - STAGE2_RENDER_SEED=${oc.env:STAGE2_RENDER_SEED,0}
+      - STAGE2_EDITOR_CREDENTIALS_FILE=/mnt/stage2/image_editor_model.txt
+    volumes:
+      - "${scenes.scene_cache}:/mnt/nre-data"
+      - "${wizard.log_dir}:/mnt/log_dir"
+      - "${or:${wizard.array_job_dir},${wizard.log_dir}}:/mnt/array_job_dir"
+      - "${repo-relative:'src'}:/repo/src"
+      - "${repo-relative:'plugins'}:/repo/plugins"
+      - "${oc.env:STAGE2_VARIANT_FILE,/home/vipuser/simulation/configs/stage2/variants.yaml}:/mnt/stage2/variants.yaml:ro"
+      - "${oc.env:STAGE2_EDITOR_CREDENTIALS_PATH,/home/vipuser/access/image_editor_model.txt}:/mnt/stage2/image_editor_model.txt:ro"
+
+# The driver only re-seeds torch before each inference when this is on
+# (alpamayo_base.py predict(); driver config model.force_determinism).
+# With it, the pinned shared seed makes the whole loop repeatable.
+driver:
+  model:
+    force_determinism: true
+
+# One renderer session, strictly serial — required by the renderer's
+# single active session constraint.
+runtime:
+  nr_workers: 1
+  endpoints:
+    renderer:
+      n_concurrent_rollouts: 1
+    controller:
+      n_concurrent_rollouts: 1
+    driver:
+      n_concurrent_rollouts: 1
+    physics:
+      n_concurrent_rollouts: 1
+    trafficsim:
+      n_concurrent_rollouts: 1
