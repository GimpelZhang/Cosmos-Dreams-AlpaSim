+# SPDX-License-Identifier: Apache-2.0
+# Copyright (c) 2026 NVIDIA Corporation
+
+"""Stage 2 Task 2.1 tests: synthetic variant actor merging."""
+
+from __future__ import annotations
+
+import math
+
+import numpy as np
+import yaml
+
+from alpasim_runtime.stage2 import variant_actors
+from alpasim_utils.geometry import Pose, Trajectory
+from alpasim_utils.scenario import AABB, TrafficObject, TrafficObjects
+
+SCENE_ID = "clipgt-testscene-0000"
+FRAME_US = 33_333
+RENDER_START_US = 0
+END_US = 20_000_000
+
+
+def _rig_trajectory(pos=(0.0, 0.0), yaw=0.0):
+    timestamps = np.arange(0, 25 * 1_000_000, FRAME_US, dtype=np.uint64)
+    half = 0.5 * yaw
+    quat = np.array([0.0, 0.0, math.sin(half), math.cos(half)], np.float32)
+    positions = np.tile(np.array([pos[0], pos[1], 0.0], np.float32),
+                        (len(timestamps), 1))
+    quaternions = np.tile(quat, (len(timestamps), 1))
+    return Trajectory(timestamps, positions, quaternions)
+
+
+def _variant(actors):
+    return {"id": "v99_test", "actors": actors}
+
+
+def _actor(aid="box_1", start=(26.0, 0.0), velocity=(0.0, 0.0),
+           activate=3.0, box=(2.4, 1.0, 1.6), label="OTHER"):
+    return {
+        "id": aid,
+        "label_class": label,
+        "box_size_xyz": list(box),
+        "start_xy_rig": list(start),
+        "velocity_xy": list(velocity),
+        "activate_s": activate,
+        "traj_end_s": 20.0,
+    }
+
+
+def _write_spec(tmp_path, actors):
+    spec = tmp_path / "variants.yaml"
+    spec.write_text(yaml.safe_dump({
+        "base_scene": SCENE_ID,
+        "variants": [_variant(actors)],
+    }))
+    return spec
+
+
+def test_identity_without_flag():
+    traffic = TrafficObjects()
+    out = variant_actors.merge_synthetic_actors(
+        traffic, SCENE_ID, _rig_trajectory(), RENDER_START_US, END_US)
+    assert out is traffic
+
+
+def test_identity_on_scene_mismatch(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path, [_actor()])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    traffic = TrafficObjects()
+    out = variant_actors.merge_synthetic_actors(
+        traffic, "clipgt-other-scene", _rig_trajectory(), RENDER_START_US, END_US)
+    assert out is traffic
+
+
+def test_coordinate_transform(tmp_path, monkeypatch):
+    # rig sits at (100, 200) facing +y (yaw 90 deg)
+    rig = _rig_trajectory(pos=(100.0, 200.0), yaw=math.pi / 2)
+    spec = _write_spec(tmp_path, [_actor(start=(26.0, 0.0))])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    out = variant_actors.merge_synthetic_actors(
+        TrafficObjects(), SCENE_ID, rig, RENDER_START_US, END_US)
+    obj = out["s2_box_1"]
+    first = obj.trajectory.positions[0]
+    assert np.allclose(first, [100.0, 226.0, 0.0], atol=1e-3)
+
+
+def test_time_window_and_frame_count(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path, [_actor(activate=3.0)])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    out = variant_actors.merge_synthetic_actors(
+        TrafficObjects(), SCENE_ID, _rig_trajectory(), RENDER_START_US, END_US)
+    traj = out["s2_box_1"].trajectory
+    # Anchored from the first video frame, through the end of the rollout.
+    assert traj.timestamps_us[0] == 0
+    assert traj.timestamps_us[-1] <= END_US
+    assert len(traj) > 500
+    assert np.all(np.diff(traj.timestamps_us) == FRAME_US)
+    # Stationary at the anchor pose before the activation timestamp.
+    pre = traj.positions[traj.timestamps_us < 3_000_000]
+    assert np.allclose(pre, pre[0], atol=1e-4)
+
+
+def test_stationary_trajectory_constant(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path, [_actor(start=(18.0, -2.0))])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    out = variant_actors.merge_synthetic_actors(
+        TrafficObjects(), SCENE_ID, _rig_trajectory(), RENDER_START_US, END_US)
+    traj = out["s2_box_1"].trajectory
+    assert np.allclose(traj.positions, traj.positions[0], atol=1e-4)
+    assert out["s2_box_1"].is_static is False
+
+
+def test_moving_trajectory_velocity_rotation(tmp_path, monkeypatch):
+    # rig yaw 90 deg: rig-frame +x velocity becomes global +y
+    rig = _rig_trajectory(pos=(10.0, 0.0), yaw=math.pi / 2)
+    spec = _write_spec(
+        tmp_path, [_actor(start=(0.0, 0.0), velocity=(1.0, 0.0), activate=2.5)])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    out = variant_actors.merge_synthetic_actors(
+        TrafficObjects(), SCENE_ID, rig, RENDER_START_US, END_US)
+    traj = out["s2_box_1"].trajectory
+    active = traj.timestamps_us >= 2_500_000
+    p_act, p_last = traj.positions[active][0], traj.positions[-1]
+    dt = (traj.timestamps_us[-1] - traj.timestamps_us[active][0]) / 1e6
+    assert abs((p_last[1] - p_act[1]) / dt - 1.0) < 0.01
+    assert abs(p_last[0] - p_act[0]) < 0.05
+    # Held at the anchor pose before activation. The first active video
+    # frame may be up to one frame interval after the activation instant.
+    pre = traj.positions[~active]
+    assert np.allclose(pre, pre[0], atol=1e-4)
+    assert np.linalg.norm(p_act - pre[0]) <= FRAME_US / 1e6 * 1.5
+
+
+def test_position_anchored_at_activation_time(tmp_path, monkeypatch):
+    # Rig drives forward at 10 m/s. An object authored 20 m ahead with a 3 s
+    # delayed activation must be placed relative to the ego at t=3 s
+    # (30 + 20 = 50 m), not at render start (20 m, which the ego has passed).
+    timestamps = np.arange(0, 25 * 1_000_000, FRAME_US, dtype=np.uint64)
+    quat = np.array([0.0, 0.0, 0.0, 1.0], np.float32)
+    t_s = timestamps.astype(np.float64) / 1e6
+    positions = np.stack(
+        [10.0 * t_s, np.zeros_like(t_s), np.zeros_like(t_s)], axis=1
+    ).astype(np.float32)
+    rig = Trajectory(timestamps, positions, np.tile(quat, (len(timestamps), 1)))
+
+    spec = _write_spec(tmp_path, [_actor(start=(20.0, 0.0), activate=3.0)])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    out = variant_actors.merge_synthetic_actors(
+        TrafficObjects(), SCENE_ID, rig, RENDER_START_US, END_US)
+    first = out["s2_box_1"].trajectory.positions[0]
+    assert np.allclose(first, [50.0, 0.0, 0.0], atol=0.1)
+
+
+def test_existing_objects_preserved(tmp_path, monkeypatch):
+    spec = _write_spec(tmp_path, [_actor()])
+    monkeypatch.setenv("STAGE2_VARIANT_SPEC", str(spec))
+    monkeypatch.setenv("STAGE2_VARIANT_ID", "v99_test")
+    existing = TrafficObject(
+        track_id="orig",
+        aabb=AABB(1.0, 1.0, 1.0),
+        trajectory=Trajectory(
+            np.array([0, 33_333], dtype=np.uint64),
+            np.zeros((2, 3), np.float32),
+            np.tile(np.array([0.0, 0.0, 0.0, 1.0], np.float32), (2, 1)),
+        ),
+        is_static=True,
+        label_class="OTHER",
+    )
+    out = variant_actors.merge_synthetic_actors(
+        TrafficObjects({"orig": existing}), SCENE_ID, _rig_trajectory(),
+        RENDER_START_US, END_US)
+    assert "orig" in out and "s2_box_1" in out
